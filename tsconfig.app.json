{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* TypeScript 7 defaults `types` to [] - nothing from node_modules/@types is loaded implicitly.
       `chrome` is the extension API global (background.ts, lib/extension.ts); vite/client comes in
       through the reference in src/types/vite-env.d.ts. */
    "types": ["chrome"],

    /* Bundler mode. Vite (Oxc) transpiles each file on its own, so every file must be
       transpilable in isolation, and type-only imports must say so. */
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias. Vite reads it from here too (resolve.tsconfigPaths in vite.config.ts), so this
       is the single place it is declared. No baseUrl: removed in TS 7; under "bundler" the paths
       are resolved relative to this file. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting. `strict` and `noUncheckedSideEffectImports` are on by default since TS 6. */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  /* __mocks__ is in here so the type-aware linter can see it. */
  "include": ["src", "__mocks__"]
}
