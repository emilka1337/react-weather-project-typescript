{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "tabWidth": 4,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortImports": {
    "ignoreCase": true,
    "newlinesBetween": true
  },
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["*.json", "*.jsonc", "*.yml", "*.yaml"],
      "options": { "tabWidth": 2 }
    }
  ],
  "ignorePatterns": ["*.md", "package-lock.json", "dist/**", "coverage/**", ".vitest/**", "public/**"]
}
